   "source": "print(\"=\"*60)\nprint(\"GENERATING ARTIFACTS\")\nprint(\"=\"*60)\n\nos.makedirs('work/figures', exist_ok=True)\n\n# 1. Position vs CTR Chart\nplt.figure(figsize=(10, 6))\nposition_ctr = df.groupby(df['avg_position'].round(1))['ctr'].mean()\nplt.plot(position_ctr.index, position_ctr.values, marker='o', linewidth=2, color='#4a90d9')\nplt.xlabel('Search Position')\nplt.ylabel('Average CTR')\nplt.title('CTR by Search Position')\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig('work/figures/position_vs_ctr.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"✅ Saved: work/figures/position_vs_ctr.png\")\n\n# 2. Feature Importance Chart\nplt.figure(figsize=(10, 6))\nimportance_df_sorted = importance_df.head(8).copy()\nplt.barh(importance_df_sorted['feature'], importance_df_sorted['importance'], color='#4a90d9')\nplt.xlabel('Importance')\nplt.title('Feature Importance')\nplt.gca().invert_yaxis()\nplt.tight_layout()\nplt.savefig('work/figures/feature_importance.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"✅ Saved: work/figures/feature_importance.png\")\n\n# 3. Action Distribution\nplt.figure(figsize=(8, 6))\ncolors = {'CRITICAL': '#dc3545', 'PRIORITIZE': '#fd7e14', 'MONITOR': '#ffc107', 'IGNORE': '#28a745'}\naction_counts = df['action'].value_counts()\nplt.bar(action_counts.index, action_counts.values, color=[colors.get(x, '#6c757d') for x in action_counts.index])\nplt.xlabel('Action Level')\nplt.ylabel('Number of Pages')\nplt.title('Action Level Distribution')\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig('work/figures/action_distribution.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"✅ Saved: work/figures/action_distribution.png\")\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"ALL ARTIFACTS GENERATED\")\nprint(\"=\"*60)\nprint(\"\"\"\nwork/figures/\n├── results_comparison.png    ✅ Model vs Baseline chart\n├── position_vs_ctr.png       ✅ Position vs CTR chart\n├── feature_importance.png    ✅ Feature importance chart\n└── action_distribution.png   ✅ Action level distribution chart\n\nThese files are ready to be embedded in the deployed paper.\n\"\"\")"
